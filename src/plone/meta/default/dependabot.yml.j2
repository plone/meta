version: 2
updates:

  - package-ecosystem: "github-actions"
    directory: "/"
    schedule:
      # Check for updates to GitHub Actions every week
      interval: "weekly"
    cooldown:
      default-days: 7
{% if auto_update %}
    # The auto-update workflow brings the updates via plone.meta,
    # so only security updates are opened by Dependabot.
    open-pull-requests-limit: 0
{% endif %}
