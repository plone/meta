ci:
    autofix_prs: false
    autoupdate_schedule: monthly

repos:
{% if use_ruff %}
-   repo: https://github.com/astral-sh/ruff-pre-commit
    rev: v0.11.12
    hooks:
    -   id: ruff-format
    -   id: ruff
        args: [--fix]
{% else %}
-   repo: https://github.com/asottile/pyupgrade
    rev: v3.22.0
    hooks:
    -   id: pyupgrade
        args: [--%(minimal_python_version)s-plus]
-   repo: https://github.com/pycqa/isort
    rev: 9.0.2
    hooks:
    -   id: isort
-   repo: https://github.com/psf/black-pre-commit-mirror
    rev: 26.10.1
    hooks:
    -   id: black
{% endif %}
-   repo: https://github.com/collective/zpretty
    rev: 4.0.3
    hooks:
    -   id: zpretty
%(zpretty_extra_lines)s
##
# Add extra configuration options in .meta.toml:
#  [pre_commit]
#  zpretty_extra_lines = """
#  _your own configuration lines_
#  """
##
{% if not use_ruff %}
-   repo: https://github.com/PyCQA/flake8
    rev: 7.4.1
    hooks:
    -   id: flake8
%(flake8_extra_lines)s
##
# Add extra configuration options in .meta.toml:
#  [pre_commit]
#  flake8_extra_lines = """
#  _your own configuration lines_
#  """
##
{% endif %}
-   repo: https://github.com/codespell-project/codespell
    rev: v2.4.3
    hooks:
    -   id: codespell
        additional_dependencies:
          - tomli
%(codespell_extra_lines)s
##
# Add extra configuration options in .meta.toml:
#  [pre_commit]
#  codespell_extra_lines = """
#  _your own configuration lines_
#  """
##
-   repo: https://github.com/mgedmin/check-manifest
    rev: "0.51"
    hooks:
    -   id: check-manifest
-   repo: https://github.com/regebro/pyroma
    rev: "5.1b2"
    hooks:
    -   id: pyroma
-   repo: https://github.com/mgedmin/check-python-versions
    rev: "0.25.0"
    hooks:
    -   id: check-python-versions
        args: ['--only', '%(check_python_versions_files)s']
-   repo: https://github.com/collective/i18ndude
    rev: "6.3.0"
    hooks:
    -   id: i18ndude
%(i18ndude_extra_lines)s

##
# Add extra configuration options in .meta.toml:
#  [pre_commit]
#  i18ndude_extra_lines = """
#  _your own configuration lines_
#  """
##

%(extra_lines)s
##
# Add extra configuration options in .meta.toml:
#  [pre_commit]
#  extra_lines = """
#  _your own configuration lines_
#  """
##
