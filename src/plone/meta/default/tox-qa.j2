[testenv:format]
description = automatically reformat code
skip_install = true
deps =
    prek
commands =
{% if use_ruff %}
    prek run -a ruff-format
    prek run -a ruff
{% else %}
    prek run -a pyupgrade
    prek run -a isort
    prek run -a black
{% endif %}
    prek run -a zpretty

[testenv:lint]
description = run linters that will help improve the code style
skip_install = true
deps =
    prek
commands =
    prek run -a

[testenv:dependencies]
description = check if the package defines all its dependencies
skip_install = true
deps =
    build
    z3c.dependencychecker==3.0
commands =
    python -m build --wheel
    dependencychecker

[testenv:dependencies-graph]
description = generate a graph out of the dependencies of the package
skip_install = false
allowlist_externals =
    sh
deps =
    pipdeptree==2.5.1
    graphviz  # optional dependency of pipdeptree
commands =
    sh -c 'pipdeptree --exclude setuptools,wheel,pipdeptree,zope.interface,zope.component --graph-output svg > dependencies.svg'
